# {{ ansible_managed }}
# readsb network-only: no SDR, pull the local ATC feed. Design §4B.
RECEIVER_OPTIONS="--net-only --net-connector {{ atc_readsb_net_connector }}"
DECODER_OPTIONS="--max-range 300"
NET_OPTIONS="--net --net-heartbeat 60 --net-ro-size 1200 --net-ro-interval 0.05 --net-sbs-port {{ atc_feed_sbs_port }} --net-json-port 30047"
JSON_OPTIONS="--write-json {{ atc_readsb_json_dir }} --write-json-every 1"
{% if atc_readsb_disable_aircraft_db %}
# AE… synthetic hex must not map to real airframes
DB_OPTIONS="--db-file none"
{% endif %}
